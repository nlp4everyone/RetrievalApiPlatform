FROM ghcr.io/mlflow/mlflow:v3.5.0

COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /usr/local/bin/uv

# curl is required by the compose healthcheck at runtime
RUN apt-get update && apt-get install -y \
      curl \
      && rm -rf /var/lib/apt/lists/*

# Install psycopg2-binary (or psycopg2)
RUN uv pip install --system psycopg2-binary==2.9.11 boto3==1.40.50
