# Port config
FASTAPI_PORT=8005
REDIS_PORT=6379
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Qdrant's port is published by its own container (docker run -p 6333:6333).
# The app takes the port from QDRANT_URL.

# API Config
# API Keys
SERVING_API_KEY=token
FASTAPI_API_KEY=token
UNDATASIO_API_KEY=
LLAMAPARSE_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# PDF parsing backend. Every other format (.txt, .md, .docx, .doc, images)
# is parsed via the Unstructured API, so only PDF has a backend worth choosing.
PDF_PARSER_PROVIDER=llamaparse

# Text chunking backend: "chonkie" or "langchain"
CHUNKING_PROVIDER=chonkie

# Logging config (TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# auto (detect TTY), console (colorized text), or json (structured, for docker/prod)
LOG_FORMAT=auto

# Embedding provider: "openai" (OpenAI-compatible endpoint, e.g. vLLM) or "tei"
# (raw TEI /embed request). The URL/API key below are shared by every provider -
# point them at whichever embedding server you run.
EMBEDDING_PROVIDER=openai
DENSE_EMBEDDING_URL=http://172.17.0.1:8100/v1
DENSE_EMBEDDING_API_KEY=token

# Sparse (lexical) embedding - opt-in, since it needs a second model server.
# When enabled it is initialized and probed at startup exactly like the dense
# one. Provider "vllm" reads token ids from /tokenize and token weights from
# /pooling on a BGE-M3 style model; the URL is the server root (a trailing
# "/v1" is stripped for you).
SPARSE_EMBEDDING_ENABLED=false
SPARSE_EMBEDDING_PROVIDER=vllm
SPARSE_EMBEDDING_URL=http://172.17.0.1:8101
SPARSE_EMBEDDING_API_KEY=token
SPARSE_MODEL_NAME=BAAI/bge-m3

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=retrieval-db
POSTGRES_HOST=postgres

# Minio
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_ENDPOINT_URL=http://minio:9000

# Vector store provider: "qdrant" or "milvus" (milvus not implemented yet).
# Startup connects only this backend; collections created on the other one
# become unreachable until you switch back.
VECTOR_STORE_PROVIDER=qdrant

# Qdrant - required when VECTOR_STORE_PROVIDER=qdrant
# External service, not part of this stack. 172.17.0.1 is the Docker bridge
# gateway: correct when Qdrant runs on the same host, otherwise use its address.
# Run one with: docker run -d --name qdrant_db -p 6333:6333 -p 6334:6334 \
#   -e QDRANT__SERVICE__API_KEY=change-me -v qdrant_data:/qdrant/storage \
#   qdrant/qdrant:v1.19        (v1.17+ required for weighted RRF)
QDRANT_URL=http://172.17.0.1:6333
QDRANT_API_KEY=change-me

# Milvus - MILVUS_URI required when VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=

# Langfuse (tracing, self-hosted - exported via OpenTelemetry OTLP)
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_BASE_URL=http://localhost:3001