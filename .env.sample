# Port config
FASTAPI_PORT=8005
REDIS_PORT=6379
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API Keys
FASTAPI_API_KEY=token
LLAMAPARSE_API_KEY=
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# PDF parsing backend; all other formats go through the Unstructured API.
PDF_PARSER_PROVIDER=llamaparse

# Chunking has no configuration: the splitter is chosen per request via
# chunking_splitter, or detected from the document when that is omitted.

# Logging config (TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# auto (detect TTY), console (colorized text), or json (structured, for docker/prod)
LOG_FORMAT=auto

# Dense embedding provider: "openai" (OpenAI-compatible endpoint, e.g. vLLM) or "tei" (raw TEI /embed).
EMBEDDING_PROVIDER=openai
DENSE_EMBEDDING_URL=http://172.17.0.1:8100/v1
DENSE_EMBEDDING_API_KEY=token

# Sparse (lexical) embedding - opt-in
SPARSE_EMBEDDING_ENABLED=false
SPARSE_EMBEDDING_PROVIDER=vllm
SPARSE_EMBEDDING_URL=http://172.17.0.1:8101
SPARSE_EMBEDDING_API_KEY=token
SPARSE_MODEL_NAME=BAAI/bge-m3

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=retrieval-db
POSTGRES_HOST=postgres

# Minio
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_ENDPOINT_URL=http://minio:9000

# Backend for new vector stores: "qdrant" or "milvus"
VECTOR_STORE_PROVIDER=qdrant

# Qdrant (external) - required when VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://172.17.0.1:6333
QDRANT_API_KEY=change-me

# Milvus (external) - required when VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://172.17.0.1:19530
MILVUS_TOKEN=

# Langfuse (tracing)
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_BASE_URL=http://172.17.0.1:3000